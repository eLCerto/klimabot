ANTHROPIC_API_KEY=sk-ant-api03-...

# The company contact the bot gives customers (complaints, a refused consent, a closed conversation).
# Without COMPANY_PHONE the bot offers only the e-mail.
# COMPANY_EMAIL=info@example.sk
# COMPANY_PHONE=+421 900 000 000

# Where the bot writes logs, leads, sessions and its ledgers (default: this folder; /data in Docker):
# KLIMABOT_DATA_DIR=data
# Behind a reverse proxy (nginx, a Hugging Face Space), the number of proxies; docker-compose.yml
# already sets 1 for Caddy (2 if a CDN proxies in front of it):
# KLIMABOT_TRUSTED_PROXIES=1

# Docker on a server (README → Docker → On a server): Caddy in front with HTTPS for this domain.
# Its DNS must point at the server, and ports 80 and 443 must be open.
# COMPOSE_PROFILES=https
# KLIMABOT_DOMAIN=klimabot.example.sk

# /admin (cost report, today's spend, leads, reply feedback): any user name + this password. Off when unset.
# KLIMABOT_ADMIN_TOKEN=

# Lead e-mail to the project manager (optional; off unless SMTP_HOST and LEAD_MAIL_TO are set).
# When a conversation with a lead is finished, its handoff brief is mailed to LEAD_MAIL_TO.
# The PM's address (several: comma-separated):
# LEAD_MAIL_TO=pm@example.sk
# SMTP server; port 587 uses STARTTLS, 465 uses SSL:
# SMTP_HOST=smtp.example.sk
# SMTP_PORT=587
# SMTP_USER=klimabot@example.sk
# Use an app password, not your mailbox password:
# SMTP_PASSWORD=
# Sender address (defaults to SMTP_USER) and a daily cap on lead e-mails:
# LEAD_MAIL_FROM=klimabot@example.sk
# LEAD_MAIL_MAX_PER_DAY=30
